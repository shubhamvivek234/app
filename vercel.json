{
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://socialentangler-b92a8.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://api.unravler.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
